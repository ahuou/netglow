{
  "name": "netglow",
  "version": "0.1.0",
  "private": true,
  "description": "Drop in a neural network and a recording of its inputs, get an animated video of its real activations. Runs entirely in your browser.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-ort.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-ort.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/public-sans": "5.3.0",
    "gifenc": "1.0.3",
    "mediabunny": "1.62.0",
    "onnxruntime-web": "1.30.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  }
}
